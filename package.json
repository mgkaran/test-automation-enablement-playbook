{
  "name": "test-automation-enablement-playbook",
  "version": "1.0.0",
  "private": true,
  "description": "A personal proof-of-concept describing a practical approach to introducing, standardizing and scaling test automation across application teams.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium tests/ui",
    "test:api": "playwright test --project=api tests/api",
    "test:headed": "playwright test --project=chromium --headed",
    "test:report": "playwright show-report",
    "build:pages": "tsc --noEmit && vite build --mode static --base=/test-automation-enablement-playbook/ && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "preview:pages": "vite preview --port 4173 --strictPort --base=/test-automation-enablement-playbook/"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
