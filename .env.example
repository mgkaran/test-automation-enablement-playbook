# Copy to .env and adjust locally. .env is git-ignored and must never be committed.
#
# The demo application ships with published placeholder credentials, so the suite
# runs without this file. A real project would supply real values here (locally)
# and through the pipeline's secret store (in CI) - never through source control.

TEST_USERNAME=demo.user
TEST_PASSWORD=playbook-demo

# Point the suite at an already-running instance instead of starting one.
# BASE_URL=http://localhost:5173
